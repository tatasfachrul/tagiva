# ==============================================================================
# Tagiva (tagiva.com) — Environment Variables Template
# ==============================================================================
# Copy this file to `.env.local` for local development:
#   cp .env.example .env.local
#
# Reference: docs/SECURITY.md (Section 8.2) & docs/ARCHITECTURE.md
# NEVER commit `.env` or `.env.local` with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Public Environment Variables (Exposed to Browser + Server)
# ------------------------------------------------------------------------------

# Canonical application URL (used for OAuth redirects, public invoice links `/i/[token]`, and checkout callbacks)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Project URL & Anonymous Key (safe to expose only because RLS is enabled on all tables)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ------------------------------------------------------------------------------
# 2. Server-Only Secrets — Supabase Admin (NEVER prefix with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------

# Supabase Service Role Key (bypasses RLS; strictly restricted to `/api/webhooks/billing` and `/api/cron/daily`)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. Server-Only Secrets — Transactional Email (Resend)
# ------------------------------------------------------------------------------

# Resend API Key for sending invoice emails (`FR-9`) and subscription expiry reminders (`D-26`)
# Leave as `mock` or empty in local dev to use the mock email fallback.
RESEND_API_KEY=re_your_resend_api_key

# ------------------------------------------------------------------------------
# 4. Server-Only Secrets — Indonesian Payment Gateway Adapter (D-10, D-48)
# ------------------------------------------------------------------------------

# Active payment gateway provider: 'xendit' | 'midtrans' | 'mayar'
PAYMENT_GATEWAY_PROVIDER=xendit

# Unified gateway credentials (used by `src/lib/billing/*-adapter.ts`)
# Leave as `mock` in local dev to use mock checkout URLs.
PAYMENT_GATEWAY_SECRET_KEY=your-gateway-secret-key
PAYMENT_GATEWAY_WEBHOOK_SECRET=your-gateway-webhook-secret

# Optional provider-specific fallback keys (if not using unified keys above):
# XENDIT_SECRET_KEY=xnd_development_...
# XENDIT_WEBHOOK_TOKEN=your-xendit-callback-token
# MIDTRANS_SERVER_KEY=SB-Mid-server-...

# ------------------------------------------------------------------------------
# 5. Server-Only Secrets — Scheduled Jobs (Vercel Cron, D-50)
# ------------------------------------------------------------------------------

# Secret token used to authenticate `GET /api/cron/daily` (`Authorization: Bearer <CRON_SECRET>`)
# Generate with: `openssl rand -hex 32`
CRON_SECRET=your-random-cron-secret-token

# ------------------------------------------------------------------------------
# 6. Testing & E2E (Optional)
# ------------------------------------------------------------------------------

# Base URL for Playwright E2E test suite (`npm run test:e2e`)
# PLAYWRIGHT_TEST_BASE_URL=http://localhost:3000
